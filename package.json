{
  "name": "blur-electron-app",
  "version": "1.3.0",
  "description": "Local RetinaFace workflow for private face anonymization",
  "author": {
    "name": "TheCheon",
    "email": "noreply@users.noreply.github.com"
  },
  "private": true,
  "_comment": "blur electron app metadata; comment stored here in lowercase",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:all": "electron-builder --linux AppImage deb --win nsis portable --mac dmg zip"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.thecheon.blur",
    "productName": "Blur Faces",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "files": [
      "index.html",
      "renderer.js",
      "main.js",
      "preload.js",
      "style.css",
      "app.py",
      "retina_mask.py",
      "requirements.txt",
      "package.json",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "name": "blur"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
